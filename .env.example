# Discord
DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_application_client_id
GUILD_IDS=123456789012345678,987654321098765432

# Logging
LOG_LEVEL=info

# Spotify (optional, recommended for better playlist stability)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Music tuning (optional)
MUSIC_LOCK_TIMEOUT_MS=15000
MUSIC_STALE_LOCK_RELEASE_MS=60000
MUSIC_NO_PLAYBACK_TIMEOUT_MS=180000
MUSIC_EMPTY_CHANNEL_TIMEOUT_MS=60000
MUSIC_AUTOPLAY_RECENT_LIMIT=20
MUSIC_AUTOPLAY_RECENT_TTL_MS=2700000
MUSIC_AUTOPLAY_RANDOM_POOL_SIZE=5
MUSIC_PLAYLIST_PROGRESSIVE_FLAT_TIMEOUT_MS=30000
MUSIC_PLAYLIST_PROGRESSIVE_MAX_ENTRIES=200
MUSIC_PLAYLIST_PROGRESSIVE_BATCH_DELAY_MS=250
